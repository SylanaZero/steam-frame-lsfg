{
  "$schema": "https://json.schemastore.org/vulkan-layer.json",
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_LS_frame_generation",
    "type": "GLOBAL",
    "library_path": "libVkLayer_lsfg.so",
    "api_version": "1.3.0",
    "implementation_version": "2",
    "description": "Lossless Scaling Frame Generation Vulkan Layer for Valve Steam Frame (ARM64 / Adreno 750)",
    "functions": {
      "vkGetInstanceProcAddr": "lsfg_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "lsfg_GetDeviceProcAddr"
    },
    "enable_environment": {
      "ENABLE_LSFG": "1"
    },
    "disable_environment": {
      "DISABLE_LSFG": "1"
    }
  }
}

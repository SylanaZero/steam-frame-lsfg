#!/usr/bin/env bash
# Steam Frame LSFG Launch Wrapper
# Usage in Steam Launch Options:
# ~/lsfg %command%
# or:
# /usr/local/bin/lsfg-frame %command%

set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/steam-frame-lsfg"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/steam-frame-lsfg"
LOG_FILE="$LOG_DIR/lsfg.log"

GLOBAL_CONFIG="$CONFIG_DIR/config.toml"
APP_ID="${SteamAppId:-${SteamGameId:-${STEAM_COMPAT_APP_ID:-0}}}"
[ "$APP_ID" != "0" ] && export SteamAppId="$APP_ID"

# Debug logging: set LSFG_DEBUG=1 to enable detailed log capture in ~/.local/share/steam-frame-lsfg/lsfg.log
if [ "${LSFG_DEBUG:-0}" = "1" ]; then
    mkdir -p "$LOG_DIR"
    echo "=== Steam Frame LSFG Session: $(date) ===" > "$LOG_FILE"
    echo "AppID: $APP_ID" >> "$LOG_FILE"
    echo "Command: $@" >> "$LOG_FILE"
fi

# 1. Profile Resolution
TARGET_CONFIG="$GLOBAL_CONFIG"
if [ "$APP_ID" != "0" ] && [ -f "$CONFIG_DIR/profiles/$APP_ID.toml" ]; then
    TARGET_CONFIG="$CONFIG_DIR/profiles/$APP_ID.toml"
fi

# Fallback defaults if config files are missing
ENABLED=1
MULTIPLIER=2
FLOW_SCALE=0.75
PERF_MODE=1
OVERRIDE_PRESENT=0
DLL_PATH=""

# Helper function to parse TOML keys
get_toml_val() {
    local file="$1"
    local key="$2"
    if [ -f "$file" ]; then
        grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" | head -n1 | cut -d'=' -f2 | tr -d ' "\r\n'
    fi
}

if [ -f "$TARGET_CONFIG" ]; then
    CFG_ENABLED=$(get_toml_val "$TARGET_CONFIG" "enabled")
    [ "$CFG_ENABLED" = "false" ] && ENABLED=0
    
    CFG_MULT=$(get_toml_val "$TARGET_CONFIG" "multiplier")
    [ -n "$CFG_MULT" ] && MULTIPLIER="$CFG_MULT"
    
    CFG_FLOW=$(get_toml_val "$TARGET_CONFIG" "flow_scale")
    [ -n "$CFG_FLOW" ] && FLOW_SCALE="$CFG_FLOW"
    
    CFG_PERF=$(get_toml_val "$TARGET_CONFIG" "performance_mode")
    [ "$CFG_PERF" = "false" ] && PERF_MODE=0
    
    CFG_OP=$(get_toml_val "$TARGET_CONFIG" "override_present_mode")
    [ "$CFG_OP" = "true" ] && OVERRIDE_PRESENT=1
    [ "$CFG_OP" = "false" ] && OVERRIDE_PRESENT=0

    CFG_DLL=$(get_toml_val "$TARGET_CONFIG" "dll_path")
    [ -n "$CFG_DLL" ] && DLL_PATH="$CFG_DLL"
fi

# 2. Automatic lsfg-vk.dll Discovery if not configured
if [ -z "$DLL_PATH" ] || [ ! -f "$DLL_PATH" ]; then
    SEARCH_LOCATIONS=(
        "${XDG_DATA_HOME:-$HOME/.local/share}/steam-frame-lsfg/lib/lsfg-vk.dll"
        "$HOME/.steam/steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
        "$HOME/.local/share/Steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
        "/run/media/*/steamapps/common/Lossless Scaling/lsfg-vk.dll"
        "/run/media/*/*/steamapps/common/Lossless Scaling/lsfg-vk.dll"
        "/var/mnt/storage/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    )
    for vdf in "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" "$HOME/.steam/steam/steamapps/libraryfolders.vdf"; do
        if [ -f "$vdf" ]; then
            while read -r libpath; do
                [ -n "$libpath" ] && SEARCH_LOCATIONS+=("$libpath/steamapps/common/Lossless Scaling/lsfg-vk.dll")
            done < <(grep '"path"' "$vdf" 2>/dev/null | cut -d '"' -f 4 || true)
        fi
    done

    for p in "${SEARCH_LOCATIONS[@]}"; do
        if [ -f "$p" ]; then
            DLL_PATH="$p"
            break
        fi
    done

    # Check removable media paths with wildcards
    if [ -z "$DLL_PATH" ]; then
        for match in /run/media/*/steamapps/common/Lossless\ Scaling/lsfg-vk.dll /run/media/*/*/steamapps/common/Lossless\ Scaling/lsfg-vk.dll; do
            if [ -f "$match" ]; then
                DLL_PATH="$match"
                break
            fi
        done
    fi

    # Fallback deep search across Steam directories if still not found
    if [ -z "$DLL_PATH" ]; then
        DLL_PATH=$(find "$HOME/.local/share/Steam" "$HOME/.steam" /run/media -iname "lsfg-vk.dll" 2>/dev/null | head -n1 || true)
    fi

    # Fallback: check package root directory last
    if [ -z "$DLL_PATH" ]; then
        WRAPPER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd || true)"
        if [ -n "$WRAPPER_ROOT" ] && [ -f "$WRAPPER_ROOT/lsfg-vk.dll" ]; then
            DLL_PATH="$WRAPPER_ROOT/lsfg-vk.dll"
        fi
    fi
fi

if [ -z "$DLL_PATH" ] || [ ! -f "$DLL_PATH" ]; then
    echo "[SteamFrame-LSFG] WARNING: lsfg-vk.dll could not be located. Launching game without framegen."
    exec "$@"
fi

# 3. Export Environment Variables for Vulkan Layer & Turnip
if [ "$ENABLED" -eq 1 ]; then
    # Upstream lsfg-vk layer configuration variables
    export ENABLE_LSFG=1
    export LSFGVK_ENV=1
    export LSFGVK_CONFIG="$TARGET_CONFIG"
    export LSFGVK_DLL_PATH="$DLL_PATH"
    export LSFGVK_MULTIPLIER="${LSFGVK_MULTIPLIER:-$MULTIPLIER}"
    export LSFGVK_FLOW_SCALE="${LSFGVK_FLOW_SCALE:-$FLOW_SCALE}"
    export LSFGVK_PERFORMANCE_MODE="${LSFGVK_PERFORMANCE_MODE:-$PERF_MODE}"
    export LSFGVK_OVERRIDE_PRESENT_MODE="${LSFGVK_OVERRIDE_PRESENT_MODE:-$OVERRIDE_PRESENT}"
    # Debug logging: set LSFG_DEBUG=1 to record detailed runtime and loader logs
    if [ "${LSFG_DEBUG:-0}" = "1" ]; then
        export LSFGVK_LOG_LEVEL="info"
        export LSFGVK_LOG_FILE="$LOG_FILE"
        export VK_LOADER_DEBUG="error,warn,info"
        echo "Resolved lsfg-vk.dll: $DLL_PATH" >> "$LOG_FILE"
        echo "Active Profile: $TARGET_CONFIG" >> "$LOG_FILE"
        echo "Framegen Settings: ${LSFGVK_MULTIPLIER}x | Flow: $LSFGVK_FLOW_SCALE | PerfMode: $LSFGVK_PERFORMANCE_MODE" >> "$LOG_FILE"
        echo "Layer Activated: $VK_INSTANCE_LAYERS" >> "$LOG_FILE"
        echo "--- Game Runtime Log Output ---" >> "$LOG_FILE"
    fi

    # Legacy environment variables fallback
    export LSFG_MULTIPLIER="$LSFGVK_MULTIPLIER"
    export LSFG_FLOW_SCALE="$LSFGVK_FLOW_SCALE"
    export LSFG_PERFORMANCE_MODE="$LSFGVK_PERFORMANCE_MODE"
    export LSFG_DLL_PATH="$DLL_PATH"
    
    # Ensure Vulkan layer is discovered across both implicit and explicit locations
    LAYER_LIB_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/steam-frame-lsfg/lib"
    IMPLICIT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/implicit_layer.d"
    EXPLICIT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/explicit_layer.d"
    LAYER_PATHS="$IMPLICIT_DIR:$EXPLICIT_DIR"

    export LD_LIBRARY_PATH="$LAYER_LIB_DIR:${LD_LIBRARY_PATH:-}"
    export VK_LAYER_PATH="$LAYER_PATHS${VK_LAYER_PATH:+:$VK_LAYER_PATH}"
    export VK_ADD_LAYER_PATH="$LAYER_PATHS${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"

    if [ -n "$VK_INSTANCE_LAYERS" ]; then
        export VK_INSTANCE_LAYERS="VK_LAYER_LSFGVK_frame_generation:$VK_INSTANCE_LAYERS"
    else
        export VK_INSTANCE_LAYERS="VK_LAYER_LSFGVK_frame_generation"
    fi
    export VK_LOADER_LAYERS_ENABLE="VK_LAYER_LSFGVK_frame_generation${VK_LOADER_LAYERS_ENABLE:+,$VK_LOADER_LAYERS_ENABLE}"

    # SteamOS Gamescope WSI & HDR Workarounds
    export ENABLE_GAMESCOPE_WSI="${ENABLE_GAMESCOPE_WSI:-0}"
    export DISABLE_GAMESCOPE_WSI="${DISABLE_GAMESCOPE_WSI:-1}"
    export DXVK_HDR=0

    # Presentation mode: default to mailbox to prevent double-present FIFO stutter/flickering
    if [ "$LSFGVK_OVERRIDE_PRESENT_MODE" = "1" ]; then
        export MESA_VK_WSI_PRESENT_MODE="${MESA_VK_WSI_PRESENT_MODE:-fifo}"
    else
        export MESA_VK_WSI_PRESENT_MODE="${MESA_VK_WSI_PRESENT_MODE:-mailbox}"
    fi

    echo "[SteamFrame-LSFG] Active for AppID $APP_ID | Multiplier: ${LSFGVK_MULTIPLIER}x | Flow: $LSFGVK_FLOW_SCALE | PerfMode: $LSFGVK_PERFORMANCE_MODE | OverridePresent: $LSFGVK_OVERRIDE_PRESENT_MODE"
else
    export ENABLE_LSFG=0
    echo "[SteamFrame-LSFG] Disabled for AppID $APP_ID"
fi

# 4. Hand off execution to game
if [ "${LSFG_DEBUG:-0}" = "1" ]; then
    exec "$@" >> "$LOG_FILE" 2>&1
else
    exec "$@"
fi


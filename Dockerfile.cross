# Multiarch Debian cross-compilation environment for Steam Frame LSFG (aarch64)
FROM debian:bookworm-slim

RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        crossbuild-essential-arm64 \
        cmake \
        ninja-build \
        git \
        pkg-config \
        python3 \
        ca-certificates \
        file && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Run the automated build script
CMD ["bash", "scripts/build-cross-layer.sh"]
